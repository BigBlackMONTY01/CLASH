{
  "outputDirectory": "dist/public",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://clash-6clx.onrender.com*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
