# ── Clash Frontend — Environment Variables ──────────────────────────
#
# Copy this file to .env.local for local overrides.
# On Vercel, set these in Project Settings → Environment Variables.
#
# VITE_API_URL
#   Leave empty to use the Vite dev proxy (local development).
#   On Vercel, leave empty to use vercel.json's /api rewrite to the Render backend.
#   If you intentionally bypass that rewrite, set this to the Render backend's base URL.
#
VITE_API_URL=
